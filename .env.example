# Copy this file to .env and fill it in. .env is git-ignored; never commit it or paste it into chat.
#
# Higgsfield needs nothing here: sign in once with `higgsfield auth login` and the CLI stores
# its own credentials.

# OwnerRez API access. Optional if you pull photos from a public listing page with --url.
#   OWNERREZ_USERNAME = the email you sign in to OwnerRez with
#   OWNERREZ_TOKEN    = a Personal Access Token created in OwnerRez (Settings > API)
OWNERREZ_USERNAME=
OWNERREZ_TOKEN=

# Optional overrides
# VIDEO_OUTPUT_DIR=videos
# HIGGSFIELD_BIN=/full/path/to/@higgsfield/cli/vendor/hf
# FFMPEG_BIN=/full/path/to/ffmpeg
# FFPROBE_BIN=/full/path/to/ffprobe
